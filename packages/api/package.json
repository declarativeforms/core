{
  "name": "@declarativeforms/api",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -b --force && cp -r src/core/services/templates dist/core/services/",
    "dev": "tsx watch src/main.ts",
    "lint": "prettier --check --config prettier.config.cjs src/**/*.ts",
    "start": "node dist/main.js",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.7.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@declarativeforms/core": "*",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.2.0",
    "resend": "^6.12.3"
  }
}
