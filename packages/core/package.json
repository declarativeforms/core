{
  "name": "@declarativeforms/core",
  "version": "0.1.0",
  "description": "YAML parsing, compilation, validation, and runtime for Declarative Forms",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -b --force",
    "test": "jest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "handlebars": "^4.7.9",
    "jsep": "^1.4.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
