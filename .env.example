# Public hostname. Create an A/AAAA record pointing here before starting Compose.
DOMAIN=forms.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Protects submission-read endpoints.
# Generate with: openssl rand -hex 32
API_KEY=replace-with-a-long-random-value

# Used to sign respondent email-verification tokens.
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=replace-with-another-long-random-value

# Optional. Exact owner/repository entries trusted to run connections and analytics.
# Separate multiple repositories with commas.
GITHUB_TRUSTED_REPOSITORIES=

# Optional. A read-only fine-grained token is required only for allowlisted private repositories.
GITHUB_TOKEN=

# MongoDB. Use URL-safe values because Compose includes them in the connection URL.
MONGO_ROOT_USERNAME=declarativeforms
MONGO_ROOT_PASSWORD=replace-with-a-long-url-safe-password
MONGODB_DATABASE_NAME=declarativeforms

# Private S3-compatible object storage provided by the Compose stack.
MINIO_ROOT_USER=declarativeforms
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-password
MINIO_APP_USER=declarativeforms-api
MINIO_APP_PASSWORD=replace-with-a-different-long-minio-password
MINIO_BUCKET=declarativeforms
AWS_REGION=us-east-1

# Optional. Required only by email verification and email connections.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
