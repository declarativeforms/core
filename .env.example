# Public deployment. Point this hostname at the Docker host before starting
# Traefik, and use a real mailbox for Let's Encrypt notices.
DOMAIN=forms.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Hostname for the form management interface. Point it at the same Docker host
# as DOMAIN. Leave empty to derive `studio.<DOMAIN>` in the Compose file.
STUDIO_DOMAIN=

# Used in absolute URLs returned for uploaded files. Leave empty to derive it
# from DOMAIN in the production Compose file.
PUBLIC_BASE_URL=

# MongoDB. Use URL-safe credentials because Compose embeds them in a URI.
MONGO_ROOT_USERNAME=declarativeforms
MONGO_ROOT_PASSWORD=replace-with-a-long-url-safe-password
MONGODB_DATABASE_NAME=declarativeforms

# Private S3-compatible object storage provided by MinIO.
MINIO_ROOT_USER=declarativeforms
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-password
MINIO_BUCKET=declarativeforms
AWS_REGION=us-east-1

# Local HTTP ports used by compose.local.yaml. Studio needs its own, because
# both containers listen on 8080 internally.
CORE_PORT=8080
STUDIO_PORT=8081

# Where the web server reaches the API. Baked into the image at build time, so
# the default matches the Compose service name and rarely needs changing.
# API_INTERNAL_ORIGIN=http://api:8080

# Published image tag to run, and the tag auto-update follows.
#
# `latest` tracks the default branch: CI re-points it on every push to main, so
# the updater sees a new digest and rolls web, studio, api and scheduler onto
# it.
#
# A commit tag such as sha-2e6a4c9 is written once and never moves. Setting one
# pins the deployment and makes auto-update a no-op, because the digest behind
# the tag never changes. That is both the off switch and the way back after a
# bad release. Run `sudo ./scripts/setup-digitalocean.sh --tag sha-2e6a4c9` so
# this file and the running containers stay in agreement.
IMAGE_TAG=latest

# Seconds between auto-update checks. Read from this file on every pass, so a
# change takes effect without restarting anything. Set to 0 to park the updater
# and deploy by hand instead.
UPDATE_INTERVAL=300

# Services the updater may recreate. Traefik, MongoDB and MinIO are absent on
# purpose: their versions are pinned in compose.yaml and changing them stays a
# deliberate re-run of the setup script.
UPDATE_SERVICES=web studio api scheduler

# Optional. Fine-grained PAT used to read forms from selected private GitHub
# repositories. Grant read-only Contents permission and no write permissions.
GITHUB_TOKEN=

# Optional. Branch a form URL resolves against when no `?branch=` query
# parameter is given. Defaults to `main`, not to the repository's own default
# branch. Changing this changes how every existing form URL resolves.
GITHUB_DEFAULT_BRANCH=main

# Optional. Single-character prefix on generated form ids, used to recognise a
# GitHub-backed form id. Defaults to `a`. Changing this invalidates the ids of
# forms that were already resolved.
GITHUB_FORM_PREFIX=a

# Optional. Single-character prefix on ids of forms stored in this deployment
# rather than pulled from GitHub. Defaults to `i`. It must differ from
# GITHUB_FORM_PREFIX, and must not be a hex digit, or an internal id becomes
# indistinguishable from a GitHub-backed one. Changing it breaks existing
# internal form URLs. Read at module scope, so it is set on api and scheduler.
INTERNAL_FORM_PREFIX=i

# Required for the authenticated management API. Signing key for the bearer
# tokens issued after OAuth login. Generate with `openssl rand -base64 48`.
# Leave empty and every authenticated route answers 503, which is how a
# deployment runs with the management API switched off. Rotating it signs every
# outstanding token out immediately.
AUTH_JWT_SECRET=

# Required for the authenticated management API. Separate key that seals the
# OAuth `state` and the one-time auth code. Kept apart from AUTH_JWT_SECRET so
# rotating one does not break the other, and so the two token families can
# never be confused. Generate with `openssl rand -base64 48`.
AUTH_STATE_SECRET=

# Optional. Lifetime in seconds of an issued bearer token. Defaults to 3600.
# There are no refresh tokens: on expiry the client repeats the authorize
# redirect, which GitHub does not re-prompt for.
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600

# Required for login. Comma-separated list of exact `origin + path` values the
# OAuth callback may redirect back to. Matched exactly: no wildcards and no
# prefix matching. Empty falls back to MANAGEMENT_BASE_URL.
AUTH_ALLOWED_REDIRECT_URIS=

# Required for login. Comma-separated browser origins allowed to call the auth,
# organization and form-management endpoints. Public form rendering and
# submission stay open to any origin regardless of this value.
AUTH_ALLOWED_ORIGINS=

# Optional. Origin of the management console. Defaults to PUBLIC_BASE_URL.
# Host the console on a different origin from rendered forms: a form can run
# author-supplied expressions in the visitor's browser, so sharing an origin
# would expose console tokens to any form.
MANAGEMENT_BASE_URL=

# Required for GitHub login. OAuth app credentials. Register the callback as
# `<PUBLIC_BASE_URL>/api/v1/auth/github/callback`. Leave empty and the GitHub
# authorize route answers 404 while the rest of the API runs normally.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Scopes requested at GitHub login. Defaults to `user:email`, which is
# all the API reads: login resolves the primary verified email address and
# nothing else. Organizations are held in this deployment, not read from GitHub,
# so `read:org` is deliberately not requested.
GITHUB_OAUTH_SCOPE=user:email

# Optional. Largest form definition accepted by a write endpoint, in bytes.
# Defaults to 262144. Well below the 10 MiB body limit because YAML aliases can
# expand a small document enormously while parsing.
FORMS_MAX_DEFINITION_BYTES=262144

# Optional. Google Maps JavaScript API key. Enables address autocomplete for
# `address` fields. Without it, address fields fall back to manual text entry.
# Restrict the key to the Places API and your own domain.
#
# Read by the web server on every request, so changing it needs only a restart,
# never a rebuild.
GOOGLE_MAPS_API_KEY=

# Optional. Required only for email connections.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
