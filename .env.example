# Public deployment. Point this hostname at the Docker host before starting
# Traefik, and use a real mailbox for Let's Encrypt notices.
DOMAIN=forms.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Used in absolute URLs returned for uploaded files. Leave empty to derive it
# from DOMAIN in the production Compose file.
PUBLIC_BASE_URL=

# MongoDB. Use URL-safe credentials because Compose embeds them in a URI.
MONGO_ROOT_USERNAME=declarativeforms
MONGO_ROOT_PASSWORD=replace-with-a-long-url-safe-password
MONGODB_DATABASE_NAME=declarativeforms

# Private S3-compatible object storage provided by MinIO.
MINIO_ROOT_USER=declarativeforms
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-password
MINIO_BUCKET=declarativeforms
AWS_REGION=us-east-1

# Local HTTP port used by compose.local.yaml.
CORE_PORT=8080

# Where the web server reaches the API. Baked into the image at build time, so
# the default matches the Compose service name and rarely needs changing.
# API_INTERNAL_ORIGIN=http://api:8080

# Published image tag to run. `latest` tracks the default branch; a release tag
# such as v1.2.0 pins the deployment.
IMAGE_TAG=latest

# Optional. Fine-grained PAT used to read forms from selected private GitHub
# repositories. Grant read-only Contents permission and no write permissions.
GITHUB_TOKEN=

# Optional. Branch a form URL resolves against when no `?branch=` query
# parameter is given. Defaults to `main`, not to the repository's own default
# branch. Changing this changes how every existing form URL resolves.
GITHUB_DEFAULT_BRANCH=main

# Optional. Single-character prefix on generated form ids, used to recognise a
# GitHub-backed form id. Defaults to `a`. Changing this invalidates the ids of
# forms that were already resolved.
GITHUB_FORM_PREFIX=a

# Optional. Google Maps JavaScript API key. Enables address autocomplete for
# `address` fields. Without it, address fields fall back to manual text entry.
# Restrict the key to the Places API and your own domain.
#
# Read by the web server on every request, so changing it needs only a restart,
# never a rebuild.
GOOGLE_MAPS_API_KEY=

# Optional. Required only for email connections.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
