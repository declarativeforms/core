{
  "name": "declarativeforms",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:react && npm run build:api && npm run build:web",
    "build:core": "npm run build -w @declarativeforms/core",
    "build:react": "npm run build -w @declarativeforms/react",
    "build:api": "npm run build -w @declarativeforms/api",
    "build:web": "npm run build -w @declarativeforms/web",
    "dev:web": "npm run dev -w @declarativeforms/web",
    "dev:api": "npm run dev -w @declarativeforms/api",
    "lint": "npm run lint -w @declarativeforms/api && npm run lint -w @declarativeforms/web",
    "check:openapi": "node -e \"require('js-yaml').load(require('node:fs').readFileSync('packages/api/openapi.yaml', 'utf8'))\"",
    "pack:check": "npm pack --dry-run -w @declarativeforms/core && npm pack --dry-run -w @declarativeforms/react",
    "test": "npm run test:core && npm run test:react && npm run test:api",
    "test:core": "npm test -w @declarativeforms/core",
    "test:react": "npm test -w @declarativeforms/react",
    "test:api": "npm test -w @declarativeforms/api"
  }
}
